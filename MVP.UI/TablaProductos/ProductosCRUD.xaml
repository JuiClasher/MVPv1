<Window x:Class="MVP.UI.TablaProductos.ProductosCRUD"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productos CRUD" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,8">
            <Button Name="BtnRefresh" Content="Actualizar" Click="BtnRefresh_Click" Margin="0,0,8,0" Width="90"/>
            <Button Name="BtnAdd" Content="Agregar" Click="BtnAdd_Click" Margin="0,0,8,0" Width="90"/>
            <Button Name="BtnEdit" Content="Modificar" Click="BtnEdit_Click" Margin="0,0,8,0" Width="90"/>
            <Button Name="BtnDelete" Content="Eliminar" Click="BtnDelete_Click" Width="90"/>
        </StackPanel>

        <DataGrid Name="dgProductos" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DgProductos_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="200"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding CodigoSKU}" Width="120"/>
                <DataGridTextColumn Header="CódigoBarras" Binding="{Binding CodigoBarras}" Width="120"/>
                <DataGridTextColumn Header="Precio Venta" Binding="{Binding PrecioVenta}" Width="100"/>
                <DataGridTextColumn Header="Precio Costo" Binding="{Binding PrecioCosto}" Width="100"/>
                <DataGridTextColumn Header="Precio Mayorista" Binding="{Binding PrecioMayorista}" Width="100"/>
                <DataGridTextColumn Header="Stock Min" Binding="{Binding StockMinimo}" Width="80"/>
                <DataGridTextColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria.Nombre}" Width="140"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca.Nombre}" Width="140"/>
                <DataGridTextColumn Header="UDM" Binding="{Binding UnidadDeMedida.Abreviatura}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Formulario -->
        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Margin="4">
                    <TextBlock Text="Nombre"/>
                    <TextBox Name="txtNombre" />
                    <TextBlock Text="Codigo SKU" Margin="0,8,0,0"/>
                    <TextBox Name="txtSKU" />
                    <TextBlock Text="Código de Barras" Margin="0,8,0,0"/>
                    <TextBox Name="txtCodigoBarras" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="4">
                    <TextBlock Text="Precio Venta"/>
                    <TextBox Name="txtPrecioVenta" />
                    <TextBlock Text="Precio Costo" Margin="0,8,0,0"/>
                    <TextBox Name="txtPrecioCosto" />
                    <TextBlock Text="Precio Mayorista" Margin="0,8,0,0"/>
                    <TextBox Name="txtPrecioMayorista" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="4">
                    <TextBlock Text="Stock Minimo"/>
                    <TextBox Name="txtStockMinimo" />
                    <TextBlock Text="Activo" Margin="0,8,0,0"/>
                    <CheckBox Name="chkActivo" IsChecked="True"/>
                    <TextBlock Text="Unidad de Medida" Margin="0,8,0,0"/>
                    <ComboBox Name="cbUdm" DisplayMemberPath="Abreviatura" SelectedValuePath="UnidadDeMedidaID"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Vertical" Margin="4">
                    <TextBlock Text="Categoria"/>
                    <ComboBox Name="cbCategoria" DisplayMemberPath="Nombre" SelectedValuePath="CategoriaID"/>
                    <TextBlock Text="Marca" Margin="0,8,0,0"/>
                    <ComboBox Name="cbMarca" DisplayMemberPath="Nombre" SelectedValuePath="MarcaID"/>
                    <Button Name="BtnClear" Content="Limpiar campos" Click="BtnClear_Click" Margin="0,12,0,0" Width="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
